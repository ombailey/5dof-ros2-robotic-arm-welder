<launch>
    <let name="urdf_file" value="$(find-pkg-share robot_arm_model)/urdf/robot_arm_model.urdf.xacro" />
    <let name="rviz_config" value="$(find-pkg-share robot_arm_model)/config/robot_arm_model_config.rviz" />
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_file)')" />
    </node>
    <node pkg="arm_hardware" exec="arm_joint_publisher" />
    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)" />  
</launch>