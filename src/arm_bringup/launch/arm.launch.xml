<launch>
    <let name="urdf_file" value="$(find-pkg-share robot_arm_model)/urdf/robot_arm_model.urdf.xacro" />
    <let name="gazebo_config" value="$(find-pkg-share arm_bringup)/config/gazebo_bridge.yaml" />
    <let name="rviz_config" value="$(find-pkg-share robot_arm_model)/config/robot_arm_model_config.rviz" />
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_file)')" />
    </node>
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="empty.sdf -r" />
    </include>
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" />
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config)" />
    </node>
    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config)" />  
</launch>